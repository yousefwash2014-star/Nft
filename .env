# ===================================================================
# Fast NFT Mint Bot - High Speed Configuration
# املأ القيم التي تحتوي على PLACEHOLDER قبل التشغيل
# ===================================================================

# اجعلها true بعد إدخال مفاتيح OpenSea والمحافظ الصحيحة
BOT_ENABLED=false

# مفتاح قديم مفرد للتوافق
OPENSEA_API_KEY=

# مفاتيح OpenSea متعددة مفصولة بفاصلة — يتم تدويرها تلقائياً
OPENSEA_API_KEYS=OPENSEA_KEY_1,OPENSEA_KEY_2,OPENSEA_KEY_3

# تعطيل الفحص غير الضروري لتقليل التأخير
CHECK_TWITTER=false
TWITTER_BEARER_TOKEN=
ENABLE_UNIVERSAL_MINTS=false
TELEGRAM_NOTIFY_FAILURES=false
VERIFY_ONCHAIN_PRICE=true
SKIP_BALANCE_CHECK_RACE=true
FAST_FIRST_ENABLED=true

# ===================================================================
# RPC منفصل لكل شبكة + روابط احتياطية للتناوب
# ===================================================================

ETHEREUM_RPC_URL=https://eth.llamarpc.com
EXTRA_RPC_ETHEREUM_1=https://eth.merkle.io
EXTRA_RPC_ETHEREUM_2=https://ethereum.publicnode.com

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXTRA_RPC_ROBINHOOD_1=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

INK_RPC_URL=https://rpc-gel.inkonchain.com
EXTRA_RPC_INK_1=https://rpc-qnd.inkonchain.com
EXTRA_RPC_INK_2=https://ink.drpc.org

ARC_RPC_URL=https://rpc.mainnet.arc.io
EXTRA_RPC_ARC_1=https://rpc.drpc.mainnet.arc.io

# يبقى للتوافق مع الإعدادات القديمة إن كانت مستخدمة
LINK_RPC_URL=https://rpc.ankr.com/eth

# ===================================================================
# المحافظ — يجب أن تتطابق كل PRIVATE_KEY مع عنوان WALLETS المقابل
# ===================================================================

PRIVATE_KEYS=0x_PRIVATE_KEY_1,0x_PRIVATE_KEY_2,0x_PRIVATE_KEY_3
WALLETS=0x_WALLET_ADDRESS_1,0x_WALLET_ADDRESS_2,0x_WALLET_ADDRESS_3

# تيليجرام اختياري: قيمة مقابلة لكل محفظة
TELEGRAM_BOT_TOKENS=BOT_TOKEN_1,BOT_TOKEN_2,BOT_TOKEN_3
TELEGRAM_CHAT_IDS=CHAT_ID_1,CHAT_ID_2,CHAT_ID_3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===================================================================
# الأداء
# ===================================================================

MAX_CONCURRENT_MINTS=30
SCAN_INTERVAL=0.5
FIXED_GAS_LIMIT=185000
RACE_MODE=false
RACE_CASCADE_ENABLED=false
ALLOW_MULTIPLE_TX_PER_MINT=false
PERFORMANCE_PROFILE=turbo
RECV_TIMEOUT=1
