# ===================================================================
# إعدادات النظام الموحد - Fast Unified NFT Mint Bot
# ===================================================================

# تفعيل البوت (true للشراء الفعلي، false للمراقبة فقط)
BOT_ENABLED=true

# مفاتيح OpenSea API (يمكن إضافة عدة مفاتيح مفصولة بفواصل وسيتم تدويرها تلقائياً)
OPENSEA_API_KEYS=key1,key2,key3
# التوافق مع الإعداد القديم ذي المفتاح الواحد:
OPENSEA_API_KEY=
# المعدل لكل مفتاح؛ خفضه إذا ظهر HTTP 429 من OpenSea
OPENSEA_RATE_PER_KEY=3.5

# تفعيل فحص حساب X (تويتر) قبل الشراء (true/false)
CHECK_TWITTER=false
TWITTER_BEARER_TOKEN=

# تفعيل المينت الشامل للعقود والمنصات الخارجية مثل Zora و Manifold والمينت المباشر (true/false)
ENABLE_UNIVERSAL_MINTS=true

# إشعارات تيليجرام: false = إرسال نجاحات الشراء فقط، true = إرسال رسائل الفشل أيضاً
TELEGRAM_NOTIFY_FAILURES=false

# false للسرعة الأعلى؛ true يضيف قراءة سعر RPC قبل الإرسال لزيادة التحقق
VERIFY_ONCHAIN_PRICE=false

# تخطي فحص الرصيد المسبق وقت المينت الفوري لزيادة السرعة (true أسرع، false أكثر تحفظاً)
SKIP_BALANCE_CHECK_RACE=true
FAST_FIRST_ENABLED=true

# لا تجدول المراحل المستقبلية؛ انتظر اكتشاف Public وهي مفتوحة فعلياً
SCHEDULE_FUTURE_STAGES=false

# وضع التقاط Public المجانية القصيرة: إعادة فحص سريعة بدون Race أو معاملات متعددة
PERFORMANCE_PROFILE=turbo
SCAN_INTERVAL=0.25
MAX_CONCURRENT_MINTS=5
FAILED_COOLDOWN_SECONDS=1
RACE_MODE=false
RACE_CASCADE_ENABLED=false
# الحد الأقصى لعمال Race المتزامنين لمنع تشبع RPC والخيوط
RACE_MAX_WORKERS=8
ALLOW_MULTIPLE_TX_PER_MINT=false
VERIFY_ONCHAIN_PRICE=true
SKIP_BALANCE_CHECK_RACE=false
FIXED_GAS_LIMIT=0

# لا تعلن نجاحًا إلا بعد تأكيد المعاملة في بلوك
WAIT_FOR_RECEIPT=true
RECEIPT_TIMEOUT_SECONDS=45

# ===================================================================
# إعدادات روابط RPC للشبكات الرئيسية المدعومة (Ethereum, Robinhood, Arc, Ink)
# ===================================================================
# ملاحظة: النظام يتناوب تلقائياً بين الروابط الخاصة والمجانية لتجنب انتهاء الحصة!



# 1. Ethereum Mainnet RPC (Chain ID 1)
ALCHEMY_API_KEY_ETHEREUM=
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ETHEREUM_RPC_URLS=https://eth.llamarpc.com,https://ethereum.publicnode.com,https://1rpc.io/eth

# 2. Ethereum WebSocket اختياري للمراقبة السريعة
# ETHEREUM_WSS_URLS=

# 3. Robinhood Chain RPC
ALCHEMY_API_KEY_ROBINHOOD=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com

# 4. Ink Chain RPC (مضبوط تلقائياً على الرابط الرسمي السريع)
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_RPC_URLS=https://rpc-gel.inkonchain.com,https://rpc-qnd.inkonchain.com

# 5. Arc Mainnet RPC (Chain ID 5042، وليس Testnet)
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URLS=https://rpc.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io

# إضافة روابط RPC إضافية محددة لتعزيز السرعة
# EXTRA_RPC_INK_1=
# EXTRA_RPC_ROBINHOOD_1=

# ===================================================================
# إعدادات المحافظ وبوتات التيليجرام
# ===================================================================
# الطريقة الأولى: قوائم مفصولة بفواصل (تدعم حتى 10 محافظ أو أكثر)
# كل محفظة يقابلها مفتاحها وتوكن التيليجرام والـ Chat ID الخاص بها:
PRIVATE_KEYS=0x_private_key_1,0x_private_key_2,0x_private_key_3
WALLETS=0x_wallet_address_1,0x_wallet_address_2,0x_wallet_address_3
TELEGRAM_BOT_TOKENS=bot_token_1,bot_token_2,bot_token_3
TELEGRAM_CHAT_IDS=chat_id_1,chat_id_2,chat_id_3

# الطريقة الثانية: بوت عام موحد لكل المحافظ (في حال لم تحدد توكن لكل محفظة)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===================================================================
# إعدادات الأداء والسرعة
# ===================================================================
# عدد المحافظ التي يمكنها إجراء عملية المينت في نفس اللحظة
MAX_CONCURRENT_MINTS=30

# إعادة فحص أسرع للمراحل والمينتات (ثوانٍ)
SCAN_INTERVAL=1

# تحديد غاز ثابت لتسريع الإرسال وتخطي خطوة estimate_gas (ضع 0 لاستخدام التقدير الديناميكي)
FIXED_GAS_LIMIT=185000

# Ultra-Speed RPC tuning
RPC_RATE_LIMIT=18
RPC_FAST_RATE_LIMIT=40
PREFETCH_NONCE=true
NONCE_CACHE_TTL=8

# لا ترسل أي معاملة إذا تعذر التحقق on-chain من عدد Mint للمحفظة
REQUIRE_MINT_STATS=true

# تحقق on-chain من balanceOf قبل أي شراء
REQUIRE_OWNERSHIP_CHECK=true
