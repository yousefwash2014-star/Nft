# إعدادات البوت الكامل السابق — Bot-Hosting
# لا تضع أسرارًا حقيقية داخل هذا الملف أو داخل ZIP عام.

# ابدأ false للاختبار، ثم true فقط بعد مراجعة كل القيم
BOT_ENABLED=false

# OpenSea
OPENSEA_API_KEYS=key1,key2
OPENSEA_API_KEY=
OPENSEA_RATE_PER_KEY=3.5

# الفحص والمجانية
CHECK_TWITTER=false
TWITTER_BEARER_TOKEN=
ENABLE_UNIVERSAL_MINTS=true
TELEGRAM_NOTIFY_FAILURES=false
VERIFY_ONCHAIN_PRICE=false
NOTIFY_SCHEDULED=true
SCHEDULE_FUTURE_STAGES=false

# Fast-first ثم fallback للمسار العادي
FAST_FIRST_ENABLED=true
PERFORMANCE_PROFILE=turbo
SKIP_BALANCE_CHECK_RACE=true
FIXED_GAS_LIMIT=185000
WAIT_FOR_RECEIPT=true
RECEIPT_TIMEOUT_SECONDS=45

# المراقبة
SCAN_INTERVAL=0.5
RECV_TIMEOUT=2
MAX_CONCURRENT_MINTS=5
FAILED_COOLDOWN_SECONDS=1
PENDING_TX_MONITOR=false
PENDING_TX_MAX_INFLIGHT=32

# الشبكات الأربع التي تدعمها هذه النسخة
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ETHEREUM_RPC_URLS=https://eth.llamarpc.com,https://ethereum.publicnode.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_RPC_URLS=https://rpc-gel.inkonchain.com,https://rpc-qnd.inkonchain.com
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URLS=https://rpc.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io
ALCHEMY_API_KEY_ETHEREUM=
ALCHEMY_API_KEY_ROBINHOOD=

# المحافظ والوجهات: الترتيب متطابق بين القوائم
PRIVATE_KEYS=0x_private_key_1,0x_private_key_2
WALLETS=0x_wallet_address_1,0x_wallet_address_2
TELEGRAM_BOT_TOKENS=bot_token_1,bot_token_2
TELEGRAM_CHAT_IDS=chat_id_1,chat_id_2
# أو وجهة عامة واحدة لجميع المحافظ
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Race اختياري؛ اتركه false إذا أردت معاملة واحدة لكل محفظة
RACE_MODE=false
RACE_CASCADE_ENABLED=false
ALLOW_MULTIPLE_TX_PER_MINT=false
RACE_GAS_BOOST=1.35
RACE_MAX_ATTEMPTS=1
RACE_RETRY_DELAY_MS=120
RACE_PRE_SUBMIT_SECONDS=0.6
RACE_MAX_WORKERS=8
RACE_MAX_GAS_FEE_USD=0.20
RACE_CASCADE_SIZE=3
RACE_CASCADE_DELAY_MS=35
RACE_CASCADE_GAS_STEP=1.18

# تحسينات RPC اختيارية
RPC_RATE_LIMIT=18
RPC_FAST_RATE_LIMIT=40
PREFETCH_NONCE=true
NONCE_CACHE_TTL=8
REQUIRE_MINT_STATS=true
REQUIRE_OWNERSHIP_CHECK=true
