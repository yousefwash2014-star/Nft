# ================================================================
# NFT Unified Bot - ملف بيئة جاهز للنسخ
# انسخ هذا الملف باسم .env ثم املأ القيم الخاصة بك
# مهم: BOT_ENABLED=false للمراقبة فقط. غيّره إلى true للتنفيذ الحقيقي.
# ================================================================

BOT_ENABLED=false

# مفاتيح OpenSea: مفصولة بفواصل، وسيتم تدويرها تلقائياً
OPENSEA_API_KEYS=key1,key2
OPENSEA_API_KEY=
OPENSEA_RATE_PER_KEY=3.0

# فحوص اختيارية
CHECK_TWITTER=false
TWITTER_BEARER_TOKEN=
ENABLE_UNIVERSAL_MINTS=true
VERIFY_ONCHAIN_PRICE=false
TELEGRAM_NOTIFY_FAILURES=false
NOTIFY_SCHEDULED=true

# ================================================================
# الشبكات وروابط RPC
# اترك الروابط العامة الاحتياطية أو أضف روابطك الخاصة بينها بفواصل
# ================================================================



# Robinhood Chain - Chain ID 4663
ALCHEMY_API_KEY_ROBINHOOD=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com

# Ink Mainnet - Chain ID 57073
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_RPC_URLS=https://rpc-gel.inkonchain.com,https://rpc-qnd.inkonchain.com,https://rpc.inkonchain.com

# Arc Mainnet - Chain ID 5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URLS=https://rpc.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io


# مراقبة معاملات pending قبل تأكيد البلوك (اختيارية؛ تحتاج WSS سريعاً)
# اتركها فارغة لتعطيلها. يمكن استخدام Alchemy عبر ALCHEMY_API_KEY_* أعلاه.
ROBINHOOD_WSS_URLS=
INK_WSS_URLS=
ARC_WSS_URLS=
PENDING_TX_MONITOR=false
PENDING_TX_MAX_INFLIGHT=1

# ================================================================
# المحافظ
# يجب أن تتطابق أعداد PRIVATE_KEYS و WALLETS
# ================================================================
PRIVATE_KEYS=0x_private_key_1
WALLETS=0x_wallet_address_1

# Telegram عام لجميع المحافظ
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# أو قوائم منفصلة بنفس ترتيب المحافظ
TELEGRAM_BOT_TOKENS=
TELEGRAM_CHAT_IDS=

# ================================================================
# الأداء والحماية
# ================================================================
# balanced = متوازن، turbo = أسرع كشف مع ضغط أعلى على API/RPC
PERFORMANCE_PROFILE=ultra
MAX_CONCURRENT_MINTS=1
SCAN_INTERVAL=0.25
RECV_TIMEOUT=1
FIXED_GAS_LIMIT=0
SKIP_BALANCE_CHECK_RACE=false

# Race Mode: اتركه false في البداية
RACE_MODE=false
RACE_GAS_BOOST=1.20
RACE_MAX_ATTEMPTS=1
ALLOW_MULTIPLE_TX_PER_MINT=false
RACE_RETRY_DELAY_MS=250
RACE_PRE_SUBMIT_SECONDS=0.6
RACE_CASCADE_ENABLED=false
RACE_CASCADE_SIZE=2
RACE_CASCADE_DELAY_MS=75
RACE_CASCADE_GAS_STEP=1.15

# حدود الغاز بالدولار لكل شبكة
RACE_MAX_GAS_FEE_USD=0.20
RACE_MAX_GAS_FEE_USD_ROBINHOOD=0.10
RACE_MAX_GAS_FEE_USD_INK=0.10
RACE_MAX_GAS_FEE_USD_ARC=0.5
